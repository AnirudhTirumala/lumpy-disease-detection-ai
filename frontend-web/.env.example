# Required
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=lumpydb
SESSION_SECRET=replace-with-a-random-32-byte-or-longer-secret
ML_BACKEND_URL=http://127.0.0.1:5000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Required for registration OTP and password-reset emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password
EMAIL_FROM=LumpyAI <your-email@example.com>

# Optional: enables SMS verification for Indian mobile numbers
FAST2SMS_API_KEY=
